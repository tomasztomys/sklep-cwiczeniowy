{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(npx playwright test:*)",
      "Bash(docker compose:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(docker push:*)",
      "Bash(docker buildx build:*)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run check 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
